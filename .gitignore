# Full 16 MB factory flash dump — too large for git.
# Kept on disk at firmware/backup/factory-flash-16MB.bin; hash in SHA256SUMS.
# The committed factory-main.uf2 is enough to restore the program itself.
firmware/backup/*.bin

# Downloaded MicroPython firmware images (re-fetchable; see docs/flashing.md)
firmware/*.uf2

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store
.serena/

# Backup artifacts from claude-code-rig tooling
.gitignore.backup.*

# Generated speech corpora and enrolment recordings. All reproducible --
# corpora from tools/say_corpus.py and tools/train_corpus.py, recordings from
# tools/enrol.py -- and far too large to version.
corpus-tts/
corpus_noise/
corpus*/
takes/
takes-oov/
